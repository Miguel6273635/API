{
  "xsappname": "my-node-api",
  "tenant-mode": "dedicated",
  "description": "API Node.js conectada a SAP ECC vía Destination para apps móviles",
  "oauth2-configuration": {
    "redirect-uris": [
      "https://my-node-api.cfapps.us10.hana.ondemand.com/**",
      "http://localhost:8080/**"
    ]
  },
  "scopes": [
    {
      "name": "$XSAPPNAME.Display",
      "description": "Ver datos desde la app móvil"
    },
    {
      "name": "$XSAPPNAME.Edit",
      "description": "Modificar datos desde la app móvil"
    }
  ],
  "role-templates": [
    {
      "name": "Viewer",
      "description": "Acceso de solo lectura",
      "scope-references": ["$XSAPPNAME.Display"]
    },
    {
      "name": "Editor",
      "description": "Acceso completo",
      "scope-references": ["$XSAPPNAME.Display", "$XSAPPNAME.Edit"]
    }
  ]
}
